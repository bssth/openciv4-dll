	inline constexpr std::uint32_t hash_seed = 0xdeadbeefu;

	template <class K>
	std::uint32_t hash_value(const K& key) noexcept {
		if constexpr (std::is_pointer_v<K> || std::is_null_pointer_v<K>) {
			return static_cast<std::uint32_t>(reinterpret_cast<std::uintptr_t>(key)) ^ hash_seed;
		}
		else {
			return static_cast<std::uint32_t>(key) ^ hash_seed;
		}
	}

	template<class CharT, class Traits>
	inline std::uint32_t hash_value(
		std::basic_string_view<CharT, Traits> key) noexcept
	{
		std::uint32_t h = hash_seed;
		if (!key.empty()) {
			const std::size_t stride = key.size() / 16 + 1;
			const std::size_t last = key.size() - stride;
			for (std::size_t i = 0; i <= last; i += stride)
				h += static_cast<std::uint32_t>(key[i]);
		}
		return h;
	}

	inline std::uint32_t hash_value(const char* key)
	{
		return hash_value(std::string_view(key));
	}

	inline std::uint32_t hash_value(const wchar_t* key)
	{
		return hash_value(std::wstring_view(key));
	}

	template<class CharT, class Traits, class Alloc>
	inline std::uint32_t hash_value(
		const std::basic_string<CharT, Traits, Alloc>& key) noexcept
	{
		return hash_value(
			std::basic_string_view<CharT, Traits>(key.data(), key.size()));
	}

	template <class K, class Pr = std::less<K>>
	class hash_compare
	{
	public:
		enum
		{
			bucket_size = 4,
			min_buckets = 8
		};

		hash_compare() = default;
		hash_compare(Pr pred) : comp(pred) {}

		std::size_t operator()(const K& key) const { return hash_value(key); }
		bool operator()(const K& a, const K& b) const { return comp(a, b); }

	protected:
		Pr comp{};
	};


	namespace hash_map_detail
	{
		template<class Tr, class K, class Q, class = void>
		struct transparent_lookup : std::false_type {};

		template<class Tr, class K, class Q>
		struct transparent_lookup<Tr, K, Q, std::void_t<typename Tr::is_transparent>>
			: std::bool_constant<
				std::is_invocable_r_v<std::size_t, const Tr&, const Q&>
				&& std::is_invocable_r_v<bool, const Tr&, const K&, const Q&>
				&& std::is_invocable_r_v<bool, const Tr&, const Q&, const K&>> {};
	}

	template <class K, class V, class Tr = hash_compare<K, std::less<K>>, class A = std::allocator<std::pair<const K, V>>>
	class hash_map
	{
		using ValueAllocator = typename std::allocator_traits<A>::template rebind_alloc<std::pair<const K, V>>;
		using List = std::list<std::pair<const K, V>, ValueAllocator>;
		using BoundaryAllocator = typename std::allocator_traits<ValueAllocator>::template rebind_alloc<typename List::iterator>;
		using Boundaries = std::vector<typename List::iterator, BoundaryAllocator>;

	public:
		using key_type = K;
		using mapped_type = V;
		using referent_type = V;
		using value_type = std::pair<const K, V>;
		using key_compare = Tr;
		using allocator_type = ValueAllocator;
		using size_type = typename List::size_type;
		using difference_type = typename List::difference_type;
		using pointer = typename List::pointer;
		using const_pointer = typename List::const_pointer;
		using reference = value_type&;
		using const_reference = const value_type&;
		using iterator = typename List::iterator;
		using const_iterator = typename List::const_iterator;
		using reverse_iterator = typename List::reverse_iterator;
		using const_reverse_iterator = typename List::const_reverse_iterator;
		enum { bucket_size = Tr::bucket_size, min_buckets = Tr::min_buckets };

		class value_compare
		{
		public:
			// The old binary_function base supplied these typedefs.
			using first_argument_type = value_type;
			using second_argument_type = value_type;
			using result_type = bool;
			value_compare(const key_compare& traits) : comp(traits) {}
			bool operator()(const value_type& left, const value_type& right) const
			{
				return comp(left.first, right.first);
			}
		protected:
			key_compare comp;
		};

		hash_map() : hash_map(key_compare(), allocator_type()) {}
		explicit hash_map(const key_compare& comp) : hash_map(comp, allocator_type()) {}
		hash_map(const key_compare& comp, const allocator_type& alloc)
			: m_comp(comp), m_list(alloc),
			  m_begin(Tr::min_buckets + 1, m_list.end(), BoundaryAllocator(alloc)) {}

		template<class It>
		hash_map(It first, It last) : hash_map(first, last, key_compare(), allocator_type()) {}
		template<class It>
		hash_map(It first, It last, const key_compare& traits)
			: hash_map(first, last, traits, allocator_type()) {}
		template<class It>
		hash_map(It first, It last, const key_compare& traits, const allocator_type& alloc)
			: hash_map(traits, alloc)
		{
			insert(first, last);
		}

		hash_map(const hash_map& other)
			: m_comp(other.m_comp), m_list(other.get_allocator()),
			  m_begin(BoundaryAllocator(other.get_allocator()))
		{
			// VC7.1 constructs empty storage with the source allocator, then _Copy.
			// Do not use modern select_on_container_copy_construction or move stealing.
			*this = other;
		}
		hash_map& operator=(const hash_map& other)
		{
			if (this != &other)
			{
				// VC7.1 _Copy: construct pairs rather than assign const keys.
				m_begin.resize(other.m_begin.size(), end());
				m_mask = other.m_mask;
				m_maxidx = other.m_maxidx;
				m_list.clear();
				try
				{
					m_list.insert(end(), other.begin(), other.end());
					m_comp = other.m_comp;
				}
				catch (...)
				{
					m_list.clear();
					for (auto& boundary : m_begin)
						boundary = end();
					throw;
				}
				copy_boundaries(other);
			}
			return *this;
		}

		iterator begin() { return m_list.begin(); }
		iterator end() { return m_list.end(); }
		const_iterator begin() const { return m_list.begin(); }
		const_iterator end() const { return m_list.end(); }
		reverse_iterator rbegin() { return m_list.rbegin(); }
		const_reverse_iterator rbegin() const { return m_list.rbegin(); }
		reverse_iterator rend() { return m_list.rend(); }
		const_reverse_iterator rend() const { return m_list.rend(); }
		size_type max_size() const { return m_list.max_size(); }
		key_compare key_comp() const { return m_comp; }
		value_compare value_comp() const { return value_compare(key_comp()); }
		size_type size() const { return m_list.size(); }
		bool empty() const { return m_list.empty(); }
		allocator_type get_allocator() const { return m_list.get_allocator(); }

		iterator find(const K& key) { return lower_bound(key); }
		const_iterator find(const K& key) const { return lower_bound(key); }
		size_type count(const K& key) const
		{
			const auto range = equal_range(key);
			return static_cast<size_type>(std::distance(range.first, range.second));
		}

		// VC7.1 bounds only succeed for an equivalent key. Missing keys return end().
		iterator lower_bound(const K& key)
		{
			const size_type b = bucket(key);
			for (iterator it = m_begin[b]; it != m_begin[b + 1]; ++it)
				if (!m_comp(it->first, key))
					return m_comp(key, it->first) ? end() : it;
			return end();
		}
		iterator upper_bound(const K& key)
		{
			const size_type b = bucket(key);
			for (iterator it = m_begin[b + 1]; it != m_begin[b];)
				if (!m_comp(key, (--it)->first))
					return m_comp(it->first, key) ? end() : ++it;
			return end();
		}
		std::pair<iterator, iterator> equal_range(const K& key)
		{
			const size_type b = bucket(key);
			for (iterator it = m_begin[b]; it != m_begin[b + 1]; ++it)
				if (!m_comp(it->first, key))
				{
					const iterator first = it;
					for (; it != m_begin[b + 1]; ++it)
						if (m_comp(key, it->first)) break;
					if (first == it) break;
					return {first, it};
				}
			return {end(), end()};
		}
		const_iterator lower_bound(const K& key) const
		{
			const size_type b = bucket(key);
			for (const_iterator it = m_begin[b]; it != m_begin[b + 1]; ++it)
				if (!m_comp(it->first, key))
					return m_comp(key, it->first) ? end() : it;
			return end();
		}
		const_iterator upper_bound(const K& key) const
		{
			const size_type b = bucket(key);
			for (const_iterator it = m_begin[b + 1]; it != m_begin[b];)
				if (!m_comp(key, (--it)->first))
					return m_comp(it->first, key) ? end() : ++it;
			return end();
		}
		std::pair<const_iterator, const_iterator> equal_range(const K& key) const
		{
			const size_type b = bucket(key);
			for (const_iterator it = m_begin[b]; it != m_begin[b + 1]; ++it)
				if (!m_comp(it->first, key))
				{
					const const_iterator first = it;
					for (; it != m_begin[b + 1]; ++it)
						if (m_comp(key, it->first)) break;
					if (first == it) break;
					return {first, it};
				}
			return {end(), end()};
		}

		// Opt-in heterogeneous lookup: equivalent K/Q values must hash identically.
		template<class Q, std::enable_if_t<hash_map_detail::transparent_lookup<Tr, K, Q>::value, int> = 0>
		iterator find(const Q& key) { return lower_bound(key); }
		template<class Q, std::enable_if_t<hash_map_detail::transparent_lookup<Tr, K, Q>::value, int> = 0>
		const_iterator find(const Q& key) const { return lower_bound(key); }
		template<class Q, std::enable_if_t<hash_map_detail::transparent_lookup<Tr, K, Q>::value, int> = 0>
		size_type count(const Q& key) const
		{
			const auto range = equal_range(key);
			return static_cast<size_type>(std::distance(range.first, range.second));
		}

		// VC7.1 bounds only succeed for an equivalent key. Missing keys return end().
		template<class Q, std::enable_if_t<hash_map_detail::transparent_lookup<Tr, K, Q>::value, int> = 0>
		iterator lower_bound(const Q& key)
		{
			const size_type b = bucketOfHash(static_cast<size_type>(m_comp(key)));
			for (iterator it = m_begin[b]; it != m_begin[b + 1]; ++it)
				if (!m_comp(it->first, key))
					return m_comp(key, it->first) ? end() : it;
			return end();
		}
		template<class Q, std::enable_if_t<hash_map_detail::transparent_lookup<Tr, K, Q>::value, int> = 0>
		iterator upper_bound(const Q& key)
		{
			const size_type b = bucketOfHash(static_cast<size_type>(m_comp(key)));
			for (iterator it = m_begin[b + 1]; it != m_begin[b];)
				if (!m_comp(key, (--it)->first))
					return m_comp(it->first, key) ? end() : ++it;
			return end();
		}
		template<class Q, std::enable_if_t<hash_map_detail::transparent_lookup<Tr, K, Q>::value, int> = 0>
		std::pair<iterator, iterator> equal_range(const Q& key)
		{
			const size_type b = bucketOfHash(static_cast<size_type>(m_comp(key)));
			for (iterator it = m_begin[b]; it != m_begin[b + 1]; ++it)
				if (!m_comp(it->first, key))
				{
					const iterator first = it;
					for (; it != m_begin[b + 1]; ++it)
						if (m_comp(key, it->first)) break;
					if (first == it) break;
					return {first, it};
				}
			return {end(), end()};
		}
		template<class Q, std::enable_if_t<hash_map_detail::transparent_lookup<Tr, K, Q>::value, int> = 0>
		const_iterator lower_bound(const Q& key) const
		{
			const size_type b = bucketOfHash(static_cast<size_type>(m_comp(key)));
			for (const_iterator it = m_begin[b]; it != m_begin[b + 1]; ++it)
				if (!m_comp(it->first, key))
					return m_comp(key, it->first) ? end() : it;
			return end();
		}
		template<class Q, std::enable_if_t<hash_map_detail::transparent_lookup<Tr, K, Q>::value, int> = 0>
		const_iterator upper_bound(const Q& key) const
		{
			const size_type b = bucketOfHash(static_cast<size_type>(m_comp(key)));
			for (const_iterator it = m_begin[b + 1]; it != m_begin[b];)
				if (!m_comp(key, (--it)->first))
					return m_comp(it->first, key) ? end() : ++it;
			return end();
		}
		template<class Q, std::enable_if_t<hash_map_detail::transparent_lookup<Tr, K, Q>::value, int> = 0>
		std::pair<const_iterator, const_iterator> equal_range(const Q& key) const
		{
			const size_type b = bucketOfHash(static_cast<size_type>(m_comp(key)));
			for (const_iterator it = m_begin[b]; it != m_begin[b + 1]; ++it)
				if (!m_comp(it->first, key))
				{
					const const_iterator first = it;
					for (; it != m_begin[b + 1]; ++it)
						if (m_comp(key, it->first)) break;
					if (first == it) break;
					return {first, it};
				}
			return {end(), end()};
		}

		std::pair<iterator, bool> insert(const value_type& value)
		{
			if (m_maxidx <= size() / Tr::bucket_size)
				grow();
			const size_type b = bucket(value.first);
			iterator pos = m_begin[b + 1];
			while (pos != m_begin[b])
			{
				--pos;
				if (m_comp(value.first, pos->first))
					continue;
				if (m_comp(pos->first, value.first))
				{
					++pos;
					break;
				}
				return {pos, false};
			}
			const iterator it = m_list.insert(pos, value);
			for (size_type j = b; m_begin[j] == pos;) // new first element of its bucket
			{
				m_begin[j] = it;
				if (j-- == 0)
					break;
			}
			return { it, true };
		}
		iterator insert(iterator, const value_type& value)
		{
			return insert(value).first; // VC7.1 ignores the hint.
		}
		template <class It>
		void insert(It first, It last)
		{
			for (; first != last; ++first)
				insert(*first);
		}

		V& operator[](const K& key)
		{
			const iterator it = find(key);
			return it != end() ? it->second : insert(value_type(key, V())).first->second;
		}

		iterator erase(iterator it)
		{
			const size_type b = bucket(it->first);
			const iterator next = std::next(it);
			for (size_type j = b; m_begin[j] == it;)
			{
				m_begin[j] = next;
				if (j-- == 0)
					break;
			}
			m_list.erase(it);
			return next;
		}
		iterator erase(iterator first, iterator last)
		{
			if (first == begin() && last == end())
			{
				clear();
				return end();
			}
			while (first != last)
				first = erase(first);
			return first;
		}
		size_type erase(const K& key)
		{
			const auto range = equal_range(key);
			const size_type removed = static_cast<size_type>(std::distance(range.first, range.second));
			erase(range.first, range.second);
			return removed;
		}
		void erase(const key_type* first, const key_type* last)
		{
			for (; first != last; ++first) erase(*first);
		}

		void clear()
		{
			m_list.clear();
			reset();
		}

		void swap(hash_map& other)
		{
			if (this == &other)
				return;
			if (m_list.get_allocator() != other.m_list.get_allocator())
			{
				// As in VC7.1, do not swap lists with unequal allocators.
				hash_map tmp(*this);
				*this = other;
				other = tmp;
				return;
			}
			// Modern list end iterators need not follow the elements on swap.
			size_type mine = m_begin.size(), theirs = other.m_begin.size();
			while (mine != 0 && m_begin[mine - 1] == end())
				--mine;
			while (theirs != 0 && other.m_begin[theirs - 1] == other.end())
				--theirs;
			m_list.swap(other.m_list);
			m_begin.swap(other.m_begin);
			std::swap(m_mask, other.m_mask);
			std::swap(m_maxidx, other.m_maxidx);
			for (size_type i = theirs; i < m_begin.size(); ++i)
				m_begin[i] = end();
			for (size_type i = mine; i < other.m_begin.size(); ++i)
				other.m_begin[i] = other.end();
			std::swap(m_comp, other.m_comp);
		}

	private:
		size_type bucket(const K& key) const { return bucketOfHash(static_cast<size_type>(m_comp(key))); }
		size_type bucketOfHash(size_type hash) const
		{
			size_type n = hash & m_mask;
			if (m_maxidx <= n)
				n -= (m_mask >> 1) + 1;
			return n;
		}

		void reset()
		{
			m_begin.assign(Tr::min_buckets + 1, m_list.end());
			m_mask = 1;
			m_maxidx = 1;
		}

		// VC7.1 splits incrementally, without temporary storage or node allocation.
		// Like the original, a throwing hash can leave a partially split table.
		void grow()
		{
			if (m_begin.size() - 1 <= m_maxidx)
			{
				m_mask = ((m_begin.size() - 1) << 1) - 1;
				m_begin.resize(m_mask + 2, end());
			}
			else if (m_mask < m_maxidx)
				m_mask = (m_mask << 1) + 1;

			const size_type split = m_maxidx - (m_mask >> 1) - 1;
			for (iterator it = m_begin[split]; it != m_begin[split + 1];)
			{
				const size_type newBucket = static_cast<size_type>(m_comp(it->first)) & m_mask;
				if (newBucket == split)
					++it;
				else
				{
					const iterator next = std::next(it);
					if (next != end())
					{
						for (size_type j = split; m_begin[j] == it; --j)
						{
							m_begin[j] = next;
							if (j == 0) break;
						}
						m_list.splice(end(), m_list, it);
						it = std::prev(end());
						m_begin[m_maxidx + 1] = end();
					}
					for (size_type j = m_maxidx; split < j; --j)
					{
						if (m_begin[j] != end()) break;
						m_begin[j] = it;
					}
					if (next == end()) break;
					it = next;
				}
			}
			++m_maxidx;
		}

		// Translate boundaries in lockstep, as in VC7.1 _Copy: no hashing
		// or allocation after the list has been copied.
		void copy_boundaries(const hash_map& other)
		{
			iterator to = begin();
			const_iterator from = other.begin();
			for (size_type b = 0; b < m_begin.size();)
			{
				if (from == other.m_begin[b])
					m_begin[b++] = to;
				else
				{
					++from;
					++to;
				}
			}
		}

		Tr m_comp;
		List m_list;
		Boundaries m_begin; // bucket b is [m_begin[b], m_begin[b + 1]); unused buckets hold end()
		size_type m_mask = 1;
		size_type m_maxidx = 1;
	};

	// VC7.1 compares the iteration sequence, including its history-dependent order.
	template<class K, class V, class Tr, class A>
	bool operator==(const hash_map<K, V, Tr, A>& left, const hash_map<K, V, Tr, A>& right)
	{
		return left.size() == right.size() && std::equal(left.begin(), left.end(), right.begin());
	}
	template<class K, class V, class Tr, class A>
	bool operator!=(const hash_map<K, V, Tr, A>& left, const hash_map<K, V, Tr, A>& right)
	{
		return !(left == right);
	}
	template<class K, class V, class Tr, class A>
	bool operator<(const hash_map<K, V, Tr, A>& left, const hash_map<K, V, Tr, A>& right)
	{
		return std::lexicographical_compare(left.begin(), left.end(), right.begin(), right.end());
	}
	template<class K, class V, class Tr, class A>
	bool operator>(const hash_map<K, V, Tr, A>& left, const hash_map<K, V, Tr, A>& right)
	{
		return right < left;
	}
	template<class K, class V, class Tr, class A>
	bool operator<=(const hash_map<K, V, Tr, A>& left, const hash_map<K, V, Tr, A>& right)
	{
		return !(right < left);
	}
	template<class K, class V, class Tr, class A>
	bool operator>=(const hash_map<K, V, Tr, A>& left, const hash_map<K, V, Tr, A>& right)
	{
		return !(left < right);
	}
	template<class K, class V, class Tr, class A>
	void swap(hash_map<K, V, Tr, A>& left, hash_map<K, V, Tr, A>& right)
	{
		left.swap(right);
	}

}

